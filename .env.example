# QQ 开放平台：机器人 -> 开发设置
PYTHON_IMAGE=mirror.ccs.tencentyun.com/library/python:3.12-slim

QQ_APP_ID=
QQ_APP_SECRET=

# 独立的大模型中转入口。
LLM_BASE_URL=https://qqchat.example.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
# 群里只能切换到这个白名单中的模型；JSON 的键是群内使用的简称。
MODEL_CATALOG_JSON={"flash":"deepseek-v4-flash","pro":"deepseek-v4-pro[1m]","kimi":"Kimi API（国内）/kimi-k3[1m]"}
# anthropic 或 openai
LLM_API_FORMAT=anthropic
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0.8

# mention: 仅 @；smart: @/叫名字/小概率自然参与；all: 每条都回复（不推荐）
REPLY_MODE=mention
SMART_REPLY_PROBABILITY=0.06
BOT_NAME=夏莉
BOT_ALIASES=夏莉,夏莉·沃利克,Shirley,シャーリィ,小Q
# 只按 QQ member_openid 识别，多个值用逗号分隔；不要用昵称判断老师身份。
OWNER_USER_IDS=
OWNER_TITLE=老师

# 每天北京时间主动在指定群里 @老师问早安。群 OpenID 可用逗号分隔。
GOOD_MORNING_ENABLED=false
GOOD_MORNING_GROUPS=
GOOD_MORNING_TIME=07:00
CONTEXT_MESSAGES=10
MAX_REPLY_CHARS=1500

# 正文禁用 Unicode emoji；需要表达情绪时，从内置夏莉表情包中发送图片。
EMOTE_ENABLED=true
EMOTE_PATH=/app/emotes

# 仅在用户明确要求“用语音回复”或使用 /voice 时生成；失败自动回退文字。
# 音色首次使用时由隔离的 voice-adapter 通过内置夏莉参考音登记并持久化 Voice ID。
VOICE_ENABLED=false
VOICE_MODEL=qwen3-tts-vc-2026-01-22
VOICE_MAX_CHARS=240
VOICE_MAX_MB=8
# 供音色登记时短暂读取参考音的公网 HTTPS 根地址。
PUBLIC_BASE_URL=https://qqchat.example.com

# 识图：支持 JPEG、PNG、GIF、WebP；模型本身也必须支持视觉输入。
VISION_ENABLED=true
# 留空则跟随本群当前模型；也可指定一个专门的多模态模型。
VISION_MODEL=
# 留空则跟随 LLM_API_FORMAT；中转站的视觉模型也可单独使用 openai 或 anthropic。
VISION_API_FORMAT=
# 允许后续艾特回看最近多少条消息内收到的图片。
VISION_CONTEXT_MESSAGES=20
VISION_MAX_IMAGES=4
VISION_MAX_IMAGE_MB=8

# 耗时任务先立即确认并给出预计用时，结束后再汇报成功或失败。
TASK_PROGRESS_ACK_ENABLED=true
TASK_QUEUE_WORKERS=2
TASK_QUEUE_SIZE=100

# 只有明确说“生成图片/画一张图”或使用 /image 时才调用；受 AGENT_ACCESS 限制。
IMAGE_GENERATION_ENABLED=false
IMAGE_GENERATION_MODEL=qwen-image-3.0-pro
IMAGE_GENERATION_MAX_MB=20

# 参考图编辑：由中转站的百炼原生适配端点处理。
IMAGE_EDIT_ENABLED=false
IMAGE_EDIT_MODEL=qwen-image-edit-max
# 最多携带的参考图数量；角色参考默认从内置表情中选择三张 CG。
IMAGE_EDIT_MAX_IMAGES=3
IMAGE_CHARACTER_REFERENCES=害羞.png,古灵精怪1.png,担心1.png
# 提示词中明确要求写入的引号文字，统一由机器人二次排版，避免模型乱码。
IMAGE_TEXT_OVERLAY_ENABLED=true
IMAGE_TEXT_FONT_PATH=/app/fonts/DroidSansFallbackFull.ttf

# Agent 文件能力。默认仅群主/管理员可用；暂不提供任意 Shell 命令。
AGENT_ACCESS=admins
WORKSPACE_ROOT=/workspace
MAX_WORKSPACE_FILE_MB=50
WORKSPACE_QUOTA_MB=500
WORKSPACE_TOTAL_QUOTA_MB=5120
WORKSPACE_INBOX_RETENTION_DAYS=14
WORKSPACE_FILE_RETENTION_DAYS=90
WORKSPACE_PART_RETENTION_HOURS=24
MAX_TEXT_FILE_CHARS=100000

# 可选：逗号分隔的群 OpenID。留空表示平台允许加入的所有群。
ALLOWED_GROUPS=
DATABASE_PATH=/app/data/qqchat.db
DATABASE_BACKUP_DIR=/app/data/backups
DATABASE_BACKUP_INTERVAL_HOURS=24
DATABASE_BACKUP_RETENTION_DAYS=7
PERSONA_PATH=/app/persona.md
HEALTH_PORT=8080
WEBHOOK_WORKERS=2
WEBHOOK_QUEUE_SIZE=500

# 周期维护：工作区过期文件、聊天记录、数据库备份和 Webhook 去重记录。
MAINTENANCE_INTERVAL_MINUTES=360
PROCESSED_MESSAGE_RETENTION_DAYS=7
CHAT_RETENTION_DAYS=30
CHAT_MAX_MESSAGES_PER_GROUP=1000

# 受限联网工具：搜索、网页正文和天气。网页读取会阻止内网地址及非标准端口。
WEB_TOOLS_ENABLED=true
SEARCH_PROVIDER=searxng
SEARXNG_BASE_URL=http://searxng:8080
WEB_SEARCH_RESULTS=8
WEB_FETCH_MAX_KB=512
WEB_FETCH_MAX_CHARS=20000
WEB_REQUEST_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO
LOG_MESSAGE_CONTENT=false

# Bilibili 视频读取服务，仅通过 Docker 内网访问。裸链接不触发；明确要求总结/分析时读取。
BILIBILI_ENABLED=false
BILIBILI_BASE_URL=http://bilibili-mcp:8080
BILIBILI_QQCHAT_TOKEN=
BILIBILI_HISTORY_MESSAGES=20
BILIBILI_GROUP_LIMIT=3
BILIBILI_GROUP_WINDOW_SECONDS=300
