# 必须与机器人 .env 中的 LLM_API_KEY 相同，用于保护 /v1/image-edits。
ADAPTER_CLIENT_KEY=
# 百炼业务空间 API Key；只注入适配容器，不注入机器人容器。
DASHSCOPE_API_KEY=
DASHSCOPE_NATIVE_URL=https://WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
ALLOWED_MODELS=qwen-image-edit-max
MAX_IMAGES=3
MAX_IMAGE_MB=8
REQUEST_TIMEOUT_SECONDS=180
LOG_LEVEL=INFO
