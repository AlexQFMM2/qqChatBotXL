# 可复制为 .wechat.env（已忽略），只覆盖微信入口需要的配置。
# 默认读取 .env → .wechat-probe/model.env → .wechat.env；已有 shell 环境优先。
# 密钥只放本机私有文件，不要提交或通过聊天发送。
# LLM_API_KEY=
LLM_MODEL=Fusion/qqchatbot
VISION_ROUTE=fusion

# 本机没有容器内 SearXNG 时保持 false；接入现有内部服务后启用。
WECHAT_WEB_TOOLS_ENABLED=false
# 复用已部署的夏莉语音服务，以 WAV 附件回复；先升级支持 format=wav 的语音适配器。
WECHAT_VOICE_ENABLED=false
# CCR 已添加对应 Fusion 扩展后改为 fusion，与 QQ 共用后台配置。
MEDIA_ROUTE=direct
# WECHAT_PERSONA_PATH=/absolute/path/to/persona.md
# 默认复用仓库 bq/ 表情资源；容器内回退到 emotes/，需要时可覆盖。
# WECHAT_EMOTE_PATH=/absolute/path/to/emotes

# 图片和文件均已接入共用核心，当前渠道传输上限 5 MiB。
# 原生语音、主动早安、B 站适配器暂未在本机入口启用。

# 宝可梦图鉴/对战：同一 CB 服务端统一管理 QQ 与微信的唯一对局。
# 填可从本容器访问的内部服务地址；不是另一容器的 localhost。
POKEMON_SERVICE_URL=
POKEMON_SERVICE_TOKEN=
POKEMON_DEX_ENABLED=false
POKEMON_BATTLE_ENABLED=false
